  "contract": {
    "protocol": "controlled-docs-png-v2",
    "width": 1200,
    "height": 900,
    "margin": 30,
    "scale": 1,
    "background": "#ffffff",
    "fontFamily": "Inter",
    "baseFontSize": 14,
    "downscaling": false,
    "clipping": false,
    "qualification": "Manual source-fact/legibility review before timing; actual final PNG dimensions, opacity, fit and stable pixels enforced on every call.",
    "selection": "Fixed list of short structural examples from the pinned DaveBench corpus; covers flowcharts, sequences, classes, states, ER and mindmaps, plus a collapsed-subgraph negative control. Source/fact manifest frozen before v2 timing; never claims full-corpus or holdout performance.",
    "scope": "Warm repeated fixed-PNG exports. Browser peers share Chromium and one SVG-to-PNG implementation. Native public renderToPng plus required fixed-canvas normalization is charged inside its timer.",
    "typography": "Inter requested through public APIs, base size14; public per-role defaults are permitted if legible. Actual role sizes/families are retained; this is not typography-identical renderer throughput."
  },
  "metric": "Client wall time from dispatch of one source through binary PNG bytes consumed in Node; all artifact writes and output inspection outside clock. Public API and conversion clocks also retained. Dart native SVG requires an explicit Chromium conversion bridge; no Flutter substitution.",
