{
  "project": "dfadler/zombie-mermaid",
  "version": "5.17.0",
  "package": "@zombie-mermaid/mermaid-parser (dist/index.js, types in dist/shared/index.d.ts)",
  "date": "2026-11-15",
  "purpose": "Probes of zombie-mermaid's text parsers behind the reviewed gitgraph, radar, packet, kanban, mindmap, timeline, journey, gantt and requirement views (views/gitgraph.mjs, views/misc.mjs; views/reviewed-versions.mjs 5.17.0). Each concept a view declares absent cites the probes that show the model does not carry it.",
  "absentConcepts": [
    {
      "concept": "gitgraph getCurrentBranch / getHead",
      "probes": [
        "git-graph",
        "git-checkout"
      ],
      "observation": "GitGraph keeps direction, title, branches, commits and config only: no checked-out branch or head after `checkout dev`"
    },
    {
      "concept": "gitgraph getAccTitle / getAccDescription, GitGraph AST accTitle / accDescr",
      "probes": [
        "git-graph",
        "git-checkout"
      ],
      "observation": "accTitle: and accDescr: lines are accepted and leave no field"
    },
    {
      "concept": "gitgraph getBranches head of a branch without commits (other than main, or before any commit)",
      "probes": [
        "git-graph"
      ],
      "observation": "`empty` (cut from A) and `x` before its cherry-pick are listed by name only; no fork point is kept"
    },
    {
      "concept": "gitgraph getBranches enumeration order",
      "probes": [
        "git-graph"
      ],
      "observation": "branches lists main, empty, x, develop: drawing order (order: 2 last), not creation order"
    },
    {
      "concept": "GitGraph AST statements",
      "probes": [
        "git-graph"
      ],
      "observation": "commits are replayed into a commit list; checkouts and statement order are not kept"
    },
    {
      "concept": "Radar AST accTitle / accDescr",
      "probes": [
        "radar",
        "radar-accdescr"
      ],
      "observation": "accTitle: / accDescr: lines leave no field"
    },
    {
      "concept": "Radar AST Axis.label / Curve.label when equal to the name",
      "probes": [
        "radar"
      ],
      "observation": "axis A without a label has label \"A\""
    },
    {
      "concept": "Radar AST Curve.entries",
      "probes": [
        "radar"
      ],
      "observation": "c2 written {C: 3, A: 1, B: 2} is [1, 2, 3], as c1 written {1,2,3}"
    },
    {
      "concept": "Radar AST options",
      "probes": [
        "radar"
      ],
      "observation": "options carries max null, min 0 and graticule circle that were not written"
    },
    {
      "concept": "packet getAccTitle / getAccDescription, Packet AST accTitle / accDescr",
      "probes": [
        "packet"
      ],
      "observation": "acc lines leave no field"
    },
    {
      "concept": "Packet AST blocks",
      "probes": [
        "packet-counts",
        "packet-ranges"
      ],
      "observation": "`+8` / `8-23` / `24` and `0-7` / `+16` / `+1` give identical blocks"
    },
    {
      "concept": "packet getPacket row block bits",
      "probes": [
        "packet"
      ],
      "observation": "words blocks are { start, end, label }; no bit count"
    },
    {
      "concept": "kanban section icon, ticket, priority, assigned (getSections, getData section node ticket)",
      "probes": [
        "kanban",
        "kanban-column-metadata"
      ],
      "observation": "a column keeps id, text, cards and className; ::icon(bomb) and @{ ticket, priority, icon, assigned } on a column leave no field"
    },
    {
      "concept": "mindmap nodeId of a delimited node",
      "probes": [
        "mindmap"
      ],
      "observation": "root((the root)) and child1[c1] keep text and a source-order number, not root / child1"
    },
    {
      "concept": "timeline task id and score",
      "probes": [
        "timeline"
      ],
      "observation": "periods are { section, label, events }"
    },
    {
      "concept": "journey getAccTitle / getAccDescription",
      "probes": [
        "journey"
      ],
      "observation": "acc lines leave no field"
    },
    {
      "concept": "gantt getAccTitle / getAccDescription",
      "probes": [
        "gantt"
      ],
      "observation": "acc lines leave no field"
    },
    {
      "concept": "requirement getAccTitle / getAccDescription",
      "probes": [
        "requirement"
      ],
      "observation": "acc lines leave no field"
    }
  ],
  "probes": {
    "git-graph": {
      "parser": "parseGitGraph",
      "source": "gitGraph TB:\naccTitle: T\ncommit id:\"A\" tag:\"v1\" type:HIGHLIGHT\nbranch develop order: 2\nbranch empty\ncheckout develop\ncommit msg:\"hi\"\ncommit id:\"B\"\ncheckout main\nmerge develop id:\"M\" type:REVERSE tag:\"r\"\nbranch x\ncheckout x\ncherry-pick id:\"B\"\ncheckout main\nmerge x\n",
      "output": {
        "direction": "TB",
        "branches": [
          "main",
          "empty",
          "x",
          "develop"
        ],
        "commits": [
          {
            "id": "A",
            "message": "",
            "seq": 0,
            "type": "HIGHLIGHT",
            "tags": [
              "v1"
            ],
            "parents": [],
            "branch": "main"
          },
          {
            "id": "1-f47a74e",
            "message": "hi",
            "seq": 1,
            "type": "NORMAL",
            "tags": [],
            "parents": [
              "A"
            ],
            "branch": "develop"
          },
          {
            "id": "B",
            "message": "",
            "seq": 2,
            "type": "NORMAL",
            "tags": [],
            "parents": [
              "1-f47a74e"
            ],
            "branch": "develop"
          },
          {
            "id": "M",
            "message": "merged branch develop into main",
            "seq": 3,
            "parents": [
              "A",
              "B"
            ],
            "branch": "main",
            "type": "MERGE",
            "tags": [
              "r"
            ],
            "customType": "REVERSE",
            "customId": true
          },
          {
            "id": "4-1e8b36b",
            "message": "cherry-picked  into x",
            "seq": 4,
            "parents": [
              "M",
              "B"
            ],
            "branch": "x",
            "type": "CHERRY_PICK",
            "tags": [
              "cherry-pick:B"
            ]
          },
          {
            "id": "5-f50b3a2",
            "message": "merged branch x into main",
            "seq": 5,
            "parents": [
              "M",
              "4-1e8b36b"
            ],
            "branch": "main",
            "type": "MERGE",
            "tags": []
          }
        ],
        "config": {
          "mainBranchName": "main",
          "mainBranchOrder": 0,
          "showCommitLabel": true,
          "showBranches": true,
          "rotateCommitLabel": true,
          "parallelCommits": false,
          "titleTopMargin": 25,
          "diagramPadding": 8
        }
      }
    },
    "git-checkout": {
      "parser": "parseGitGraph",
      "source": "gitGraph\ncommit\nbranch dev\ncheckout dev\naccDescr: D\n",
      "output": {
        "direction": "LR",
        "branches": [
          "main",
          "dev"
        ],
        "commits": [
          {
            "id": "0-9b915a1",
            "message": "",
            "seq": 0,
            "type": "NORMAL",
            "tags": [],
            "parents": [],
            "branch": "main"
          }
        ],
        "config": {
          "mainBranchName": "main",
          "mainBranchOrder": 0,
          "showCommitLabel": true,
          "showBranches": true,
          "rotateCommitLabel": true,
          "parallelCommits": false,
          "titleTopMargin": 25,
          "diagramPadding": 8
        }
      }
    },
    "git-title": {
      "parser": "parseGitGraph",
